  "activities": [
    {
      "id": "bratwurst",
      "kind": "food",
      "title": {
        "en": "Eat a Bratwurst with mustard"
      },
      "body": {
        "en": "Grab one in a bread roll from a street stand or a market — mustard (Senf), not ketchup."
      }
    },
    {
      "id": "currywurst",
      "kind": "food",
      "title": {
        "en": "Try a Currywurst"
      },
      "body": {
        "en": "Sliced sausage with curry ketchup, usually with fries (Pommes). Ask for “mit Darm” or “ohne Darm”."
      }
    },
    {
      "id": "brezel",
      "kind": "food",
      "title": {
        "en": "Have a fresh Brezel"
      },
      "body": {
        "en": "Buy a pretzel at any bakery. Butterbrezel — with butter — is the classic breakfast on the go."
      }
    },
    {
      "id": "broetchen",
      "kind": "food",
      "title": {
        "en": "Do a Sunday-style Brötchen breakfast"
      },
      "body": {
        "en": "Fresh bread rolls from the bakery, butter, jam, cheese, cold cuts and a soft-boiled egg."
      }
    },
    {
      "id": "kaffee-kuchen",
      "kind": "food",
      "title": {
        "en": "Kaffee und Kuchen at 3 pm"
      },
      "body": {
        "en": "Afternoon coffee and cake is a ritual. Try Bienenstich, Käsekuchen or Schwarzwälder Kirschtorte."
      }
    },
    {
      "id": "schnitzel",
      "kind": "food",
      "title": {
        "en": "Eat a Schnitzel"
      },
      "body": {
        "en": "Wiener Schnitzel is veal; Schnitzel Wiener Art is pork. Jägerschnitzel comes with mushroom sauce."
      }
    },
    {
      "id": "doener",
      "kind": "food",
      "title": {
        "en": "Get a Döner"
      },
      "body": {
        "en": "The German-Turkish kebab was perfected in Berlin. Say “mit alles” for everything, “scharf” for spicy."
      }
    },
    {
      "id": "kartoffelsalat",
      "kind": "food",
      "title": {
        "en": "Taste two kinds of potato salad"
      },
      "body": {
        "en": "South: with vinegar and broth. North: with mayonnaise. Pick a side."
      }
    },
    {
      "id": "spaetzle",
      "kind": "food",
      "title": {
        "en": "Eat Käsespätzle"
      },
      "body": {
        "en": "Soft egg noodles baked with cheese and fried onions — Swabian comfort food."
      }
    },
    {
      "id": "rouladen",
      "kind": "food",
      "title": {
        "en": "Try Rinderrouladen"
      },
      "body": {
        "en": "Beef rolls with bacon, onion and pickle, braised in gravy — a typical family Sunday dish."
      }
    },
    {
      "id": "beer",
      "kind": "drink",
      "title": {
        "en": "Drink a local beer"
      },
      "body": {
        "en": "Ask for whatever is brewed nearby. A small one is “ein Kleines”."
      },
      "alt": {
        "en": "Not drinking? Try an alcohol-free beer — Germany makes very good ones."
      }
    },
    {
      "id": "apfelschorle",
      "kind": "drink",
      "title": {
        "en": "Order an Apfelschorle"
      },
      "body": {
        "en": "Apple juice with sparkling water — the national soft drink."
      }
    },
    {
      "id": "spezi",
      "kind": "drink",
      "title": {
        "en": "Try a Spezi"
      },
      "body": {
        "en": "Cola mixed with orange soda. Ask for it in any café or Späti."
