{
  "version": "2026-11-v3",
  "note": "Question ids and option ids are stable keys in the database. Never reuse an id for a different meaning: add a new id and bump the version. v3 replaced `eu` (yes/no) with `citizenship` (eu/best_friend/other); old answers are migrated in questionnaire.ts.",
  "parts": [
    {
      "id": "plan",
      "title": "Your plan",
      "intro": "These answers build your personal plan. They stay on your phone unless you choose to share them.",
      "consent": null,
      "enabled": true,
      "optionalConsent": "research_v1"
    },
    {
      "id": "research",
      "title": "Help us improve",
      "intro": "Optional. Your answers help us understand what newcomers need.",
      "consent": "research_v1",
      "enabled": false
    }
  ],
  "questions": [
    {
      "id": "purpose",
      "part": "plan",
      "type": "single",
      "required": true,
      "text": "Why are you moving to Germany?",
      "options": [
        {
          "id": "study",
          "label": "To study"
        },
        {
          "id": "work",
          "label": "For a job"
        },
        {
          "id": "chancenkarte",
          "label": "To look for a job (Opportunity Card)"
        },
        {
          "id": "family",
          "label": "To join my family"
        },
        {
          "id": "other",
          "label": "Something else",
          "freeText": true
        }
      ],
      "storage": {
        "device": "exact",
        "server": "exact"
      }
    },
    {
      "id": "citizenship",
      "part": "plan",
      "type": "single",
      "required": true,
      "text": "Which passport do you hold?",
      "help": "If you have more than one, pick the first option that fits. It decides which permit steps and deadlines apply to you.",
      "options": [
        {
          "id": "eu",
          "label": "EU country, Iceland, Liechtenstein, Norway or Switzerland"
        },
        {
          "id": "best_friend",
          "label": "Australia, Canada, Israel, Japan, New Zealand, South Korea, the UK or the USA"
        },
        {
          "id": "other",
          "label": "Another country"
        }
      ],
      "storage": {
        "device": "exact",
        "server": "exact"
      }
    },
    {
      "id": "status",
      "part": "plan",
      "type": "single",
      "required": true,
      "showIf": {
        "question": "citizenship",
        "in": [
          "best_friend",
          "other"
        ]
      },
      "text": "What is your current residence status in Germany?",
      "help": "Pick the closest one. If you're not sure, that's fine — choose “I'm not sure”.",
      "options": [
        {
          "id": "not_arrived",
          "label": "I'm not in Germany yet"
        },
        {
          "id": "visa_free",
          "label": "Visa-free stay or tourist visa"
        },
        {
          "id": "national_visa",
          "label": "National (D) visa for study, work or job search"
        },
        {
          "id": "fiktion",
          "label": "Waiting for my permit (Fiktionsbescheinigung)"
        },
        {
          "id": "temporary",
          "label": "Residence permit (Aufenthaltserlaubnis)"
        },
        {
          "id": "blue_card",
          "label": "EU Blue Card"
        },
        {
          "id": "chancenkarte",
          "label": "Opportunity Card (Chancenkarte)"
        },
        {
          "id": "permanent",
          "label": "Permanent residence (Niederlassungserlaubnis or EU long-term residence)"
        },
        {
          "id": "protection",
          "label": "Asylum procedure or protection status"
        },
        {
          "id": "not_sure",
          "label": "I'm not sure"
        },
        {
          "id": "other",
          "label": "Something else",
          "freeText": true
        }
      ],
      "storage": {
        "device": "exact",
        "server": "exact"
      }
    },
    {
      "id": "visa_end",
      "part": "plan",
      "type": "date",
      "required": false,
      "showIf": {
        "question": "status",
        "in": [
          "national_visa",
          "chancenkarte",
          "temporary",
          "blue_card"
        ]
      },
      "text": "When does your visa or permit end?",
      "help": "It's printed on your visa or card. We count your permit deadline from it. Not sure? Skip this.",
      "range": {
        "minDays": -30,
        "maxDays": 1830
      },
      "storage": {
        "device": "exact",
        "server": "none"
      }
    },
    {
      "id": "arrival",
      "part": "plan",
      "type": "date",
      "required": true,
      "text": "When did you arrive, or when will you arrive?",
      "storage": {
        "device": "exact",
        "server": "month"
      },
      "range": {
        "minDays": -730,
        "maxDays": 365
      }
    },
    {
      "id": "housing",
      "part": "plan",
      "type": "single",
      "required": true,
      "text": "Do you have a place to live in Germany?",
      "help": "You have to register your address within two weeks of moving in.",
      "options": [
        {
          "id": "moved_in",
          "label": "Yes, I've moved in"
        },
        {
          "id": "soon",
          "label": "Yes, but I haven't moved in yet"
        },
        {
          "id": "searching",
          "label": "Not yet, I'm still looking"
        }
      ],
      "storage": {
        "device": "exact",
        "server": "exact"
      }
    },
    {
      "id": "move_in",
      "part": "plan",
      "type": "date",
      "required": true,
      "showIf": {
        "question": "housing",
        "in": [
          "moved_in",
          "soon"
        ]
      },
      "text": "When did you move in, or when will you?",
      "range": {
        "minDays": -730,
        "maxDays": 365
      },
      "storage": {
        "device": "exact",
        "server": "none"
      }
    },
    {
      "id": "place",
      "part": "plan",
      "type": "city",
      "required": true,
      "text": "Where will you live?",
      "help": "Start typing your city. Not listed? Choose your state.",
      "storage": {
        "device": "exact",
        "server": "exact"
      }
    },
    {
      "id": "household",
      "part": "plan",
      "type": "single",
      "required": true,
      "text": "Who is moving with you?",
      "options": [
        {
          "id": "alone",
          "label": "Just me"
        },
        {
          "id": "partner",
          "label": "Me and my partner"
        },
        {
          "id": "children",
          "label": "Me and my children (with or without a partner)"
        },
        {
          "id": "other",
          "label": "Something else",
          "freeText": true
        }
      ],
      "storage": {
        "device": "exact",
        "server": "exact"
      }
    },
    {
      "id": "drives",
      "part": "plan",
      "type": "single",
      "required": true,
      "showIf": {
        "question": "citizenship",
        "in": [
          "best_friend",
          "other"
        ]
      },
      "text": "Will you drive a car in Germany?",
      "help": "A driving licence from outside the EU works for six months after you move here.",
      "options": [
        {
          "id": "yes",
          "label": "Yes"
        },
        {
          "id": "maybe",
          "label": "Maybe later"
        },
        {
          "id": "no",
          "label": "No"
        }
      ],
      "storage": {
        "device": "exact",
        "server": "exact"
      }
    },
    {
      "id": "german_level",
      "part": "plan",
      "type": "single",
      "required": true,
      "text": "How good is your German?",
      "options": [
        {
          "id": "none",
          "label": "I don't speak German yet"
        },
        {
          "id": "basic",
          "label": "Basic (A1–A2)"
        },
        {
          "id": "intermediate",
          "label": "Intermediate (B1–B2)"
        },
        {
          "id": "advanced",
          "label": "Advanced or native (C1+)"
        }
      ],
      "storage": {
        "device": "exact",
        "server": "exact"
      }
    },
    {
      "id": "done_already",
      "part": "plan",
      "type": "multi",
      "required": false,
      "text": "What have you already done?",
      "options": [
        {
          "id": "health-insurance",
          "label": "Health insurance"
        },
        {
          "id": "anmeldung",
          "label": "Registered my address"
        },
        {
          "id": "bank-account",
          "label": "Opened a bank account"
        },
        {
          "id": "sim-card",
          "label": "Got a German phone number"
        }
      ],
      "maps_to": "task_ids",
      "storage": {
        "device": "exact",
        "server": "exact"
      }
    },
    {
      "id": "worries",
      "part": "research",
      "type": "multi",
      "required": false,
      "max": 3,
      "text": "What worries you most right now? Pick up to three.",
      "options": [
        {
          "id": "paperwork",
          "label": "Paperwork and deadlines"
        },
        {
          "id": "housing",
          "label": "Finding a place to live"
        },
        {
          "id": "money",
          "label": "Money, taxes and bank"
        },
        {
          "id": "health",
          "label": "Health insurance and doctors"
        },
        {
          "id": "language",
          "label": "Language"
        },
        {
          "id": "friends",
          "label": "Meeting people and making friends"
        },
        {
          "id": "job",
          "label": "Finding or keeping a job"
        },
        {
          "id": "family",
          "label": "Family: childcare, school, partner"
        }
      ],
      "storage": {
        "device": "exact",
        "server": "exact"
      }
    },
    {
      "id": "helpers",
      "part": "research",
      "type": "multi",
      "required": false,
      "text": "Who is helping you with the move?",
      "options": [
        {
          "id": "employer",
          "label": "My employer"
        },
        {
          "id": "university",
          "label": "My university"
        },
        {
          "id": "friends_family",
          "label": "Friends or family in Germany"
        },
        {
          "id": "paid_service",
          "label": "A paid service (relocation agency, lawyer)"
        },
        {
          "id": "online",
          "label": "Online groups and forums"
        },
        {
          "id": "nobody",
          "label": "Nobody, I'm doing it myself"
        }
      ],
      "storage": {
        "device": "exact",
        "server": "exact"
      }
    },
    {
      "id": "paid_for_help",
      "part": "research",
      "type": "single",
      "required": false,
      "text": "Have you paid anyone to help with your move?",
      "options": [
        {
          "id": "no",
          "label": "No"
        },
        {
          "id": "lt100",
          "label": "Yes, less than €100"
        },
        {
          "id": "100_500",
          "label": "Yes, €100–500"
        },
        {
          "id": "gt500",
          "label": "Yes, more than €500"
        },
        {
          "id": "employer_paid",
          "label": "My employer paid for it"
        }
      ],
      "storage": {
        "device": "exact",
        "server": "exact"
      }
    },
    {
      "id": "read_language",
      "part": "research",
      "type": "single",
      "required": false,
      "text": "Which language would you most like to use this app in?",
      "options": [
        {
          "id": "en",
          "label": "English"
        },
        {
          "id": "ru",
          "label": "Russian"
        },
        {
          "id": "uk",
          "label": "Ukrainian"
        },
        {
          "id": "tr",
          "label": "Turkish"
        },
        {
          "id": "ar",
          "label": "Arabic"
        },
        {
          "id": "hi",
          "label": "Hindi"
        },
        {
          "id": "es",
          "label": "Spanish"
        },
        {
          "id": "other",
          "label": "Another language"
        }
      ],
      "storage": {
        "device": "exact",
        "server": "exact"
      }
    },
    {
      "id": "heard_from",
      "part": "research",
      "type": "single",
      "required": false,
      "text": "How did you find Day One?",
      "options": [
        {
          "id": "friend",
          "label": "A friend"
        },
        {
          "id": "community",
          "label": "An online group or forum"
        },
        {
          "id": "university",
          "label": "My university"
        },
        {
          "id": "employer",
          "label": "My employer"
        },
        {
          "id": "social",
          "label": "Social media"
        },
        {
          "id": "search",
          "label": "Search or an AI assistant"
        },
        {
          "id": "other",
          "label": "Somewhere else"
        }
      ],
      "storage": {
        "device": "exact",
        "server": "exact"
      }
    },
    {
      "id": "interview",
      "part": "research",
      "type": "email",
      "required": false,
      "text": "Can we call you for 20 minutes to hear about your move? Leave your email.",
      "help": "Only used to arrange the call. Stored separately from your answers.",
      "storage": {
        "device": "none",
        "server": "waitlist"
      }
    }
  ],
  "consents": {
    "research_v1": {
      "text": "Share my answers with Day One, without my name, to improve the app. Day One may publish combined statistics that cannot identify me. I can withdraw at any time in Me → Delete my data.",
      "default": false
    }
  },
  "freeTextRule": "Free-text answers to \"Something else\" stay on the device and are never sent to the server."
}
